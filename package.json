{
  "name": "industrial-core-workspace",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "repository": { "type": "git", "url": "https://github.com/lancemach/industrial-core-wasm.git" },
  "packageManager": "pnpm@12.12.1",
  "scripts": {
    "build": "pnpm --filter @industrial-core/typescript... build && pnpm --filter @industrial-core/node-demo build && pnpm --filter @industrial-core/playground build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @industrial-core/typescript test",
    "dev": "pnpm --filter @industrial-core/playground dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^16.5.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0",
    "typescript-eslint": "^8.73.0"
  }
}
